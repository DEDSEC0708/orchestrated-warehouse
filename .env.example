# ===========================================================================
# ORCHESTRATED WAREHOUSE - environment template
#
#   cp .env.example .env
#   bash scripts/generate_env.sh        # fills in the two generated keys
#
# .env is git-ignored and MUST NEVER be committed.
# Every value below is a placeholder for LOCAL DEVELOPMENT ONLY. This stack is
# not hardened for network exposure - do not port-forward it.
#
# PASSWORD RULE: keep local passwords URL-safe (letters, digits, underscore).
# They are embedded in connection URIs by docker-compose.yml, and characters
# like @ : / # would need percent-encoding there. Application code builds its
# own DSNs with proper quoting, but the compose-level URIs are plain strings.
#
# Consumed by: docker-compose.yml, docker/postgres/init/*.sh,
#              docker/airflow/init.sh, src/volthive/config/settings.py
# ===========================================================================

# --- PostgreSQL: superuser -------------------------------------------------
# Used ONLY by the container's init scripts and for manual administration.
# No application component connects with this account.
POSTGRES_USER=volthive
POSTGRES_PASSWORD=local_dev_only_change_me

# Service name on the compose network. Use localhost when running pipeline
# code from the host instead of from inside a container.
POSTGRES_HOST=postgres
# Port INSIDE the docker network. Containers always talk to 5432.
POSTGRES_PORT=5432
# Port published to your machine. Change this one if 5432 is already taken
# locally; it does not affect container-to-container traffic.
POSTGRES_HOST_PORT=5432

# --- PostgreSQL: the three logical databases -------------------------------
# warehouse : the platform itself (raw, stg, core, mart, dq, audit, ctl)
# cms       : the simulated source OLTP system
# airflow   : Airflow metadata, never touched by pipeline code
WH_DB=warehouse
CMS_DB=cms
AIRFLOW_DB=airflow

# --- PostgreSQL: least-privilege roles -------------------------------------
# Created on first boot by docker/postgres/init/01_create_roles.sh.
# wh_etl      owns the warehouse; the pipeline's identity
WH_ETL_USER=wh_etl
WH_ETL_PASSWORD=local_dev_only_change_me
# cms_owner   owns the simulated source database; the generator writes as this
CMS_OWNER_USER=cms_owner
CMS_OWNER_PASSWORD=local_dev_only_change_me
# cms_reader  READ-ONLY on the source database; what ingestion actually uses
CMS_READER_USER=cms_reader
CMS_READER_PASSWORD=local_dev_only_change_me
# wh_analyst  read-only consumer of the warehouse mart layer
WH_ANALYST_USER=wh_analyst
WH_ANALYST_PASSWORD=local_dev_only_change_me
# airflow     owns the Airflow metadata database and nothing else
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=local_dev_only_change_me

# --- Airflow: runtime ------------------------------------------------------
# Linux/WSL only: must match your host UID or bind-mounted files become
# root-owned. Find it with `id -u`. 50000 is the image default and is correct
# for Docker Desktop on Windows and macOS.
AIRFLOW_UID=50000

AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__PARALLELISM=8
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=6
AIRFLOW__CORE__DEFAULT_TIMEZONE=utc
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=False
# Port published to your machine for the Airflow UI.
AIRFLOW_WEBSERVER_HOST_PORT=8080

# GENERATE - scripts/generate_env.sh fills these in.
# The Fernet key encrypts connection passwords in the Airflow metadata
# database; publishing one would let anyone with that database decrypt every
# credential in it.
AIRFLOW__CORE__FERNET_KEY=REPLACE_ME_GENERATED_LOCALLY
AIRFLOW__WEBSERVER__SECRET_KEY=REPLACE_ME_GENERATED_LOCALLY

# --- Airflow: local UI login ----------------------------------------------
# The username is fixed and public. The password is GENERATED per machine by
# scripts/generate_env.sh, for the same reason the Fernet key is: a working
# credential committed to a public repository is a working credential, and
# "it's only local" stops being true the moment someone publishes port 8080.
#
# To read your own password back:   grep AIRFLOW_ADMIN_PASSWORD .env
#
# docker/airflow/init.sh reconciles the Airflow account to whatever is in this
# file on every `make up`, so changing it here and restarting is all it takes
# to rotate it. It refuses to start while the placeholder is still in place.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=REPLACE_ME_GENERATED_LOCALLY
AIRFLOW_ADMIN_EMAIL=admin@example.invalid
AIRFLOW_ADMIN_FIRSTNAME=Local
AIRFLOW_ADMIN_LASTNAME=Admin

# --- Airflow: UI identity --------------------------------------------------
# Cosmetic only, and all four are documented Airflow settings - no template
# overrides, no patched packages. instance_name replaces "Airflow" in the
# navbar and the browser tab title on every page, including the login screen.
AIRFLOW__WEBSERVER__INSTANCE_NAME=VoltHive - Orchestrated Warehouse
AIRFLOW__WEBSERVER__NAVBAR_COLOR=#0E3B34
AIRFLOW__WEBSERVER__NAVBAR_TEXT_COLOR=#E8F1EE
AIRFLOW__WEBSERVER__NAVBAR_HOVER_COLOR=#155047
AIRFLOW__WEBSERVER__NAVBAR_TEXT_HOVER_COLOR=#FFFFFF
AIRFLOW__WEBSERVER__NAVBAR_LOGO_TEXT_COLOR=#E8F1EE

# NOTE: AIRFLOW_CONN_WAREHOUSE_DB and AIRFLOW_CONN_CMS_DB are NOT set here.
# docker-compose.yml composes them from the role variables above, so each
# password exists in exactly one place. Airflow reads any AIRFLOW_CONN_<ID>
# variable as a connection, so nothing is stored in the metadata database.

# --- Roaming partner source (S4) -------------------------------------------
# file = deterministic local fixture client (default, used by CI - no network)
# http = call the local mock API container (arrives in Phase 5)
VOLTHIVE_PARTNER_MODE=file
VOLTHIVE_PARTNER_API_URL=http://partner-api:8099
VOLTHIVE_PARTNER_API_TOKEN=local_dev_only_token_not_a_secret
VOLTHIVE_PARTNER_API_PORT=8099

# --- Application -----------------------------------------------------------
VOLTHIVE_ENV=local
VOLTHIVE_LOG_LEVEL=INFO
# true = JSON logs (containers, CI). false = readable console output locally.
VOLTHIVE_LOG_JSON=true
# VOLTHIVE_DATA_DIR and VOLTHIVE_CONFIG_DIR are deliberately NOT set here.
#
# They are CONTAINER paths (/opt/airflow/data, /opt/airflow/configs) and
# docker-compose.yml already sets them on the services that need them, next to
# the bind mounts that create them. Setting them in .env too would be
# redundant inside the container and WRONG outside it: .env is read by
# pydantic-settings on the host as well, so `cp .env.example .env` followed by
# `make run` would point a host-side run at a directory that only exists
# inside a container, and every file source would silently find zero files.
#
# Left unset, they default to <repo>/data and <repo>/configs, derived from the
# package location rather than the working directory - which is correct for a
# host run, for pytest and for CI. Override them only if your landing zone
# genuinely lives somewhere else.
VOLTHIVE_GENERATOR_SEED=42
VOLTHIVE_GENERATOR_PROFILE=default

# Optional. Empty = no alerting, and the project has no external dependency.
ALERT_WEBHOOK_URL=

# ===========================================================================
# ORCHESTRATED WAREHOUSE - environment template
#
#   cp .env.example .env
#
# .env is git-ignored and MUST NEVER be committed.
# Every value below is a placeholder for LOCAL DEVELOPMENT ONLY. This stack is
# not hardened for network exposure - do not port-forward it.
#
# Values marked GENERATE must be produced by scripts/generate_env.sh (Phase 1).
# Consumed by: docker-compose.yml (Phase 2) and src/volthive/config (Phase 1).
# ===========================================================================

# --- PostgreSQL (single instance, three logical databases) -----------------
POSTGRES_USER=volthive
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_PORT=5432

# warehouse : the platform itself (raw, stg, core, mart, dq, audit, ctl)
# cms       : the simulated source OLTP system (source S1)
# airflow   : Airflow metadata - never touched by pipeline code
WH_DB=warehouse
CMS_DB=cms
AIRFLOW_DB=airflow

# Least-privilege roles created at first boot (Phase 2)
WH_ETL_USER=wh_etl
WH_ETL_PASSWORD=local_dev_only_change_me
CMS_READER_USER=cms_reader
CMS_READER_PASSWORD=local_dev_only_change_me
WH_ANALYST_USER=wh_analyst
WH_ANALYST_PASSWORD=local_dev_only_change_me

# --- Airflow ---------------------------------------------------------------
# Linux/WSL only: must match your host UID or bind-mounted files become
# root-owned. Find it with `id -u`. 50000 is the image default.
AIRFLOW_UID=50000

AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__PARALLELISM=8
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=6
AIRFLOW__CORE__DEFAULT_TIMEZONE=utc
AIRFLOW__WEBSERVER__WEB_SERVER_PORT=8080
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=False

# GENERATE - `python -c "from cryptography.fernet import Fernet;
#                        print(Fernet.generate_key().decode())"`
# Encrypts connection passwords in the metadata DB. Committing a real one
# would let anyone decrypt that database.
AIRFLOW__CORE__FERNET_KEY=REPLACE_ME_GENERATED_LOCALLY

# GENERATE - `python -c "import secrets; print(secrets.token_hex(32))"`
AIRFLOW__WEBSERVER__SECRET_KEY=REPLACE_ME_GENERATED_LOCALLY

# Local-only UI login, created by airflow-init (Phase 2)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=local_dev_only_change_me

# --- Airflow connections (URI form, injected as env - never stored by hand
#     in the Airflow metadata DB or in Airflow Variables) --------------------
AIRFLOW_CONN_WAREHOUSE_DB=postgresql://wh_etl:local_dev_only_change_me@postgres:5432/warehouse
AIRFLOW_CONN_CMS_DB=postgresql://cms_reader:local_dev_only_change_me@postgres:5432/cms

# --- Roaming partner source (S4) -------------------------------------------
# file = deterministic local fixture client (default, used by CI - no network)
# http = call the local mock API container (docker compose --profile with-api)
VOLTHIVE_PARTNER_MODE=file
VOLTHIVE_PARTNER_API_URL=http://partner-api:8099
VOLTHIVE_PARTNER_API_TOKEN=local_dev_only_token_not_a_secret
VOLTHIVE_PARTNER_API_PORT=8099

# --- Application -----------------------------------------------------------
VOLTHIVE_ENV=local
VOLTHIVE_LOG_LEVEL=INFO
VOLTHIVE_DATA_DIR=/opt/airflow/data
VOLTHIVE_GENERATOR_SEED=42
VOLTHIVE_GENERATOR_PROFILE=default

# Optional. Empty = no alerting, and the project has no external dependency.
ALERT_WEBHOOK_URL=
